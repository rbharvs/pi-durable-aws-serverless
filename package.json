{
  "name": "pi-durable-aws-serverless",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "oxlint --deny-warnings . && oxfmt --check . && tsc --noEmit && pnpm --dir infra exec tsc --noEmit",
    "test": "vitest run --config vitest.config.ts && pnpm test:infra",
    "test:infra": "vitest run --config vitest.infra.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "format": "oxfmt .",
    "build": "node build.mjs",
    "infra:build": "pnpm --dir infra build",
    "deploy": "pnpm check && pnpm test && pnpm test:integration && pnpm build -- \"${WORKER_ENTRY:-src/aws/worker-entry.ts}\" && pnpm infra:build && pulumi -C infra up"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "3.1152.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/dsql-signer": "3.1152.0",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.15.6",
    "esbuild": "0.28.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.9.0"
}
